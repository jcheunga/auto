PORT=1337
DATABASE_PATH=./data/automation.db
LOG_LEVEL=info

MONDAY_API_TOKEN=your-monday-token
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_SIGNING_SECRET=your-monday-signing-secret
MONDAY_STATUS_APPROVED_LABEL=Approved

GITHUB_TOKEN=your-github-token
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_BASE_BRANCH=main
GIT_WORKSPACE_ROOT=./data/git-workspaces

CODE_AGENT_COMMAND=

WORKER_CONCURRENCY=3
WORKER_MAX_RETRIES=4
WORKER_RETRY_DELAY_SECONDS=30

HEROKU_API_TOKEN=your-heroku-token
HEROKU_PIPELINE_ID=your-heroku-pipeline-id
HEROKU_TEAM_ID=your-heroku-team-id
